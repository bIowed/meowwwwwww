{
  "version": 2,
  "regions": ["iad1"],
  "routes": [
    {
      "src": "/api/proxy",
      "dest": "/api/proxy.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/index.html"
    },
    {
      "src": "/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/proxy.js?fallback_path=$1"
    }
  ]
}
